#!/usr/bin/env python3
"""Offline unit tests for insta-lookup/api/index.py (no network: requests.get is stubbed).

Run:  python3 test_insta_api.py
"""
import importlib.util
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
SPEC_PATH = os.path.join(HERE, "insta-lookup", "api", "index.py")
spec = importlib.util.spec_from_file_location("insta_api", SPEC_PATH)
api = importlib.util.module_from_spec(spec)
spec.loader.exec_module(api)

PASS = 0
FAIL = 0

def ok(cond, name):
    global PASS, FAIL
    if cond:
        PASS += 1
    else:
        FAIL += 1
        print(f"FAIL: {name}")

class Resp:
    def __init__(self, status=200, payload=None, text=None):
        self.status_code = status
        self._payload = payload
        self.text = text if text is not None else (json.dumps(payload) if payload is not None else "")
    def json(self):
        if self._payload is None:
            raise ValueError("no json")
        return self._payload

WEB_PROFILE_USER = {
    "username": "Empik", "full_name": "Maxim", "biography": "hello world",
    "external_url": "https://example.com/x", "is_verified": True, "is_private": False,
    "edge_followed_by": {"count": 199}, "edge_follow": {"count": 112},
    "edge_owner_to_timeline_media": {"count": 355},
    "profile_pic_url_hd": "https://cdn.example/a.jpg",
}

def install_fake(handler):
    calls = []
    def fake_get(url, params=None, headers=None, timeout=None):
        calls.append(url)
        return handler(url, params or {})
    api.requests.get = fake_get
    return calls

def reset_state():
    api._CACHE._data.clear()
    api._LIMITER._hits.clear()

# ---- T1: validation ----
reset_state()
status, payload = api.lookup_instagram("")
ok(status == 400 and payload["error"] == "INVALID_USERNAME", "T1a empty")
status, payload = api.lookup_instagram("a" * 31)
ok(status == 400, "T1b too long")
status, payload = api.lookup_instagram("bad name!")
ok(status == 400, "T1c bad chars")
status, payload = api.lookup_instagram("@Empik.")
ok(api.clean_username("@Empik.") == "empik", "T1d handle cleaning (trailing dot is invalid on IG)")
status, payload = api.lookup_instagram("https://www.instagram.com/empik/")
ok(api.clean_username("https://www.instagram.com/empik/") == "empik", "T1e url input")

# ---- T2: web_profile success path ----
reset_state()
calls = install_fake(lambda u, p: Resp(200, {"data": {"user": dict(WEB_PROFILE_USER)}}))
status, payload = api.lookup_instagram("empik")
d = payload.get("data", {})
ok(status == 200 and payload["success"] is True, "T2a success")
ok(d.get("username") == "empik" and d.get("full_name") == "Maxim", "T2b identity")
ok(d.get("followers") == 199 and d.get("following") == 112 and d.get("posts") == 355, "T2c counts")
ok(d.get("avatar_url") == "https://cdn.example/a.jpg", "T2d avatar")
ok(d.get("is_verified") is True and d.get("biography") == "hello world", "T2e flags/bio")
ok(len(calls) == 1, "T2f stops at first healthy upstream")

# ---- T3: cache ----
status2, payload2 = api.lookup_instagram("empik")
ok(payload2.get("cached") is True and len(calls) == 1, "T3 cache hit, no upstream call")

# ---- T4: definitive not-found short-circuits chain ----
reset_state()
calls = install_fake(lambda u, p: Resp(404, None, ""))
status, payload = api.lookup_instagram("ghostuser")
ok(status == 404 and payload["error"] == "USER_NOT_FOUND", "T4a 404")
ok(len(calls) == 1, "T4b no retry storm on missing user")

# ---- T5: user null in payload = not found ----
reset_state()
calls = install_fake(lambda u, p: Resp(200, {"data": {"user": None}}))
status, payload = api.lookup_instagram("ghostuser")
ok(status == 404, "T5a null user -> 404")
ok(len(calls) == 1, "T5b null user stops chain")

# ---- T6: web_profile down -> legacy fallback ----
reset_state()
def legacy_only(u, p):
    if "i.instagram.com" in u:
        raise api.requests.RequestException("boom")
    return Resp(200, {"data": {"user": dict(WEB_PROFILE_USER, biography="")}})
calls = install_fake(legacy_only)
status, payload = api.lookup_instagram("empik")
ok(status == 200 and payload["data"]["username"] == "empik", "T6a legacy json fallback")
ok(len(calls) == 2, "T6b chain advanced once")

# ---- T7: both fail -> og scrape ----
reset_state()
OG_HTML = """<html><head>
<meta property="og:title" content="Maxim (@empik) • Instagram photos and videos"/>
<meta property="og:description" content="355 Followers, 1.2K Following, 42 Posts - See Instagram photos and videos from Maxim (@empik)"/>
<meta property="og:image" content="https://cdn.example/og.jpg"/>
</head><body>&quot;biography&quot;:&quot;life is good&quot; &quot;is_private&quot;:true</body></html>"""
def og_only(u, p):
    if "www.instagram.com/empik/" in u and p.get("__a") == "1":
        return Resp(403, None, "")
    if "i.instagram.com" in u:
        raise api.requests.RequestException("blocked")
    return Resp(200, None, text=OG_HTML)
calls = install_fake(og_only)
status, payload = api.lookup_instagram("empik")
d = payload.get("data", {})
ok(status == 200, "T7a og scrape ok")
ok(d.get("followers") == 355 and d.get("following") == 1200 and d.get("posts") == 42, "T7b og counts")
ok(d.get("full_name") == "Maxim", "T7c og name")
ok(d.get("avatar_url") == "https://cdn.example/og.jpg", "T7d og image")

# ---- T8: everything fails -> 502 UPSTREAM_UNAVAILABLE + negative cache ----
reset_state()
def broken(u, p):
    raise api.requests.RequestException("dead")
calls = install_fake(broken)
status, payload = api.lookup_instagram("empik")
ok(status == 502 and payload["error"] == "UPSTREAM_UNAVAILABLE", "T8a 502")
ok(len(calls) == 3, "T8b all three tried")
status, payload = api.lookup_instagram("empik")
ok(payload.get("cached") is True and len(calls) == 3, "T8c failure cached (no hammering)")

# ---- T9: parse_count ----
ok(api.parse_count("12.4k") == 12400, "T9a k")
ok(api.parse_count("1,999") == 1999, "T9b commas")
ok(api.parse_count("2 million") == 2000000, "T9c words")
ok(api.parse_count(500) == 500, "T9d int")
ok(api.parse_count(None) is None and api.parse_count("x") is None, "T9e junk")
ok(api.parse_count(True) is None, "T9f bool guard")

# ---- T10: rate limiter ----
reset_state()
ok(api._LIMITER.allow("1.2.3.4") is True, "T10a first ok")
for _ in range(api.RATE_MAX_PER_WINDOW - 1):
    api._LIMITER.allow("1.2.3.4")
ok(api._LIMITER.allow("1.2.3.4") is False, "T10b window full")
ok(api._LIMITER.allow("9.9.9.9") is True, "T10c other ip fine")

# ---- T11: normalized profile drops empty fields ----
reset_state()
minimal = dict(WEB_PROFILE_USER)
minimal["biography"] = ""
minimal["external_url"] = ""
install_fake(lambda u, p: Resp(200, {"data": {"user": minimal}}))
api._CACHE._data.clear()
status, payload = api.lookup_instagram("minuser")
d = payload["data"]
ok("biography" not in d and "external_url" not in d, "T11 empties pruned")
ok(d.get("username") == "empik", "T11b upstream username wins, lowercased")

print(f"insta-api: {PASS} PASS, {FAIL} FAIL")
sys.exit(1 if FAIL else 0)
